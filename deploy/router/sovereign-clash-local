# Rewrite Clash API bind to loopback in sing-box's config. Does not restart
# sing-box: a restart while DNS goes through the tunnel deadlocks on GitHub
# rule-set fetch. Apply this only before a planned start that already has a
# working resolver, then start podkop/sing-box yourself.
set -eu
CFG=/etc/sing-box/config.json
[ -f "$CFG" ] || exit 0
grep -q '"external_controller": "127.0.0.1:9090"' "$CFG" 2>/dev/null && exit 0
tmp="$CFG.$$"
sed 's/"external_controller": "[^"]*"/"external_controller": "127.0.0.1:9090"/' "$CFG" > "$tmp" || {
  rm -f "$tmp"
  exit 1
}
mv "$tmp" "$CFG"
