[Unit]
Description=Sovereign backfill — drain router telemetry buffer into the laptop dataset
Documentation=file://~/sovereign/README.md

[Service]
Type=oneshot
ExecStart=~/.local/bin/sovereign-backfill
# Same target/env as the collector; log path is the shared XDG default.
Environment=SOVEREIGN_HOST=192.168.1.1
Environment=SOVEREIGN_USER=root
Environment=SOVEREIGN_ASKPASS=~/.local/share/sovereign/askpass.sh
Environment=SOVEREIGN_SSH_CONNECT_S=8
Environment=SOVEREIGN_TELEMETRY_S=20
Environment=SOVEREIGN_LOG=~/.local/share/sovereign/records.log
Environment=SOVEREIGN_LOG_MAX_BYTES=20000000
Environment=SOVEREIGN_LOG_GENERATIONS=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=~/.local/share/sovereign
PrivateTmp=true
