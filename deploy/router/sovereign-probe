# sovereign-probe — bounded RAM telemetry buffer on the router.
#
# The brain (laptop) is the system of record, but it can be off or asleep. This
# probe samples the SHARED telemetry (sovereign-telemetry.sh — the single source,
# also run verbatim by the laptop collector — no duplicated logic) once a minute via
# cron, into a strictly bounded ring buffer in /tmp (tmpfs = RAM only; router flash
# is never touched — the durable dataset lives on the laptop, which drains this
# buffer via sovereign-backfill).
#
# the internal engineering charter discipline, within busybox limits:
#   * Bounded: telemetry.sh gives every network call a hard timeout; the buffer is
#     capped at MAX_LINES (~14 days at 1/min, ~2.9 MB of RAM at ~145 B/line) —
#     oldest lines are dropped. Sized from evidence (largest observed laptop-off
#     gap was 3.12 days → >4x margin; 2.9 MB is <2% of ~233 MB free tmpfs).
#     Residual bound (accepted): a >14-day absence, or a router reboot mid-outage
#     (tmpfs is RAM), still loses buffered samples — flash is deliberately not used.
#   * Graceful: a failed sub-probe reports its own token (tunnel=dead etc.);
#     nothing here can fail loudly or hang the cron slot.
#   * One line per sample, self-describing `key=value` tokens — the exact snapshot
#     contract the brain's parser validates.

BUF=/tmp/sovereign-buffer.log
MAX_LINES=20160
TELEM=/usr/bin/sovereign-telemetry.sh

ts=$(date +%s)
# Run the shared telemetry and fold its one-token-per-line output into a single
# space-separated buffer line (ts= prefix gives the global timeline).
line=$(sh "$TELEM" 2>/dev/null | tr '\n' ' ')
echo "ts=$ts $line" >> "$BUF"

# Ring bound: keep only the newest MAX_LINES (atomic swap; a failed swap leaves the
# old buffer intact rather than truncating it).
lines=$(wc -l < "$BUF" 2>/dev/null || echo 0)
if [ "$lines" -gt "$MAX_LINES" ]; then
    tail -n "$MAX_LINES" "$BUF" > "$BUF.new" 2>/dev/null && mv "$BUF.new" "$BUF"
fi
exit 0
